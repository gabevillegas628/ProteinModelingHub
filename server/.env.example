# Database
DATABASE_URL="postgresql://username:password@localhost:5432/protein_modeling?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="6h"

# Server
PORT=3001
NODE_ENV=development

# Brevo Email Service (for password reset)
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Protein Model Organizer"

# Frontend URL (for password reset links)
FRONTEND_URL="http://localhost:5173"

# JaaS (Jitsi as a Service) video chat — https://jaas.8x8.vc
JAAS_APP_ID="vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JAAS_API_KEY_ID="your-api-key-id"
# Paste private key on one line with literal \n for newlines
JAAS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
