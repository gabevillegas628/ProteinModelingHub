generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  APPROVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// USER
// ============================================
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  firstName            String
  lastName             String
  role                 Role      @default(STUDENT)
  isApproved           Boolean   @default(false)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  groupMemberships       GroupMember[]
  submissions            Submission[]
  messages               Message[]
  literature             Literature[]
  messageReadStatus      MessageReadStatus[]
  viewerChats            ViewerChat[]
  viewerChatReadStatuses ViewerChatReadStatus[]

  @@map("users")
}

// ============================================
// MODEL TEMPLATE
// Admin-defined assignments that all groups must complete
// e.g., "Model 1: Active Site View", "Model 2: Secondary Structure"
// ============================================
model ModelTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  submissions  Submission[]
  viewerChats  ViewerChat[]

  @@map("model_templates")
}

// ============================================
// GROUP
// A pair of students working on one protein
// ============================================
model Group {
  id                     String    @id @default(cuid())
  name                   String    // e.g., "Team Alpha" or auto-generated
  proteinPdbId           String    // PDB identifier, e.g., "1ABC"
  proteinName            String    // Display name, e.g., "Hemoglobin"
  lastReviewRequestedAt  DateTime? // When students last requested instructor review
  // WSSP Application Fields (populated on approval)
  wsspSchoolNumber        String?
  schoolName              String?
  cloneNumber             String?
  sequenceIdentity        String?
  teacherName             String?
  teacherEmail            String?
  researchArticleCitation String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  members                GroupMember[]
  submissions            Submission[]
  messages               Message[]
  literature             Literature[]
  messageReadStatus      MessageReadStatus[]
  viewerChats            ViewerChat[]
  viewerChatReadStatuses ViewerChatReadStatus[]
  application            Application?

  @@map("groups")
}

// ============================================
// APPLICATION
// Student team application to join the program
// ============================================
model Application {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(PENDING)

  wsspSchoolNumber  String
  schoolName        String
  studentAFirstName String
  studentALastName  String
  studentAEmail     String
  studentBFirstName String
  studentBLastName  String
  studentBEmail     String
  teacherName       String
  teacherEmail      String

  cloneNumber             String
  proteinName             String
  pdbAccessionNumber      String
  sequenceIdentity        String
  researchArticleCitation String

  pdfFileName     String
  pdfFilePath     String
  rejectionReason String?

  groupId String? @unique
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applications")
}

// ============================================
// GROUP MEMBER
// Links students to their group (typically 2 per group)
// ============================================
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A student can only be in one group, and only once per group
  @@unique([groupId, userId])
  @@map("group_members")
}

// ============================================
// SUBMISSION
// A model file submitted by a group for a specific template
// ============================================
model Submission {
  id              String           @id @default(cuid())
  groupId         String
  modelTemplateId String
  submittedById   String
  fileName        String           // Original filename
  filePath        String           // Storage path
  fileSize        Int?             // Size in bytes
  status          SubmissionStatus @default(DRAFT)
  feedback        String?          // Deprecated: use comments instead
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  modelTemplate ModelTemplate @relation(fields: [modelTemplateId], references: [id], onDelete: Cascade)
  submittedBy   User          @relation(fields: [submittedById], references: [id])
  comments      Message[]     // Threaded comments on this submission

  // Track submission history - allow multiple submissions per group/template
  // Latest one is the "current" submission (query by createdAt DESC)
  @@index([groupId, modelTemplateId])
  @@map("submissions")
}

// ============================================
// MESSAGE
// Chat messages for a group (students + all instructors)
// submissionId = NULL means group chat, SET means submission comment
// ============================================
model Message {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  submissionId String?  // NULL = group chat, SET = submission comment
  content      String
  createdAt    DateTime @default(now())

  // Relations
  group      Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([submissionId, createdAt])
  @@map("messages")
}

// ============================================
// MESSAGE READ STATUS
// Tracks the last-read timestamp per user per discussion context
// submissionId = NULL means group chat, SET means submission comments
// ============================================
model MessageReadStatus {
  id           String   @id @default(cuid())
  userId       String
  groupId      String
  submissionId String?  // NULL = group chat, SET = submission comments
  lastReadAt   DateTime

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, submissionId])
  @@index([userId])
  @@map("message_read_status")
}

// ============================================
// LITERATURE
// Papers/PDFs uploaded by a group for reference
// ============================================
model Literature {
  id           String   @id @default(cuid())
  groupId      String
  uploadedById String
  title        String
  fileName     String   // Original filename
  filePath     String   // Storage path
  fileSize     Int?     // Size in bytes
  description  String?
  createdAt    DateTime @default(now())

  // Relations
  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([groupId])
  @@map("literature")
}

// ============================================
// VIEWER CHAT
// Real-time chat scoped to a group + model template
// Separate from instructor submission feedback
// ============================================
model ViewerChat {
  id              String        @id @default(cuid())
  groupId         String
  modelTemplateId String
  userId          String
  content         String
  createdAt       DateTime      @default(now())

  // Relations
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  modelTemplate ModelTemplate @relation(fields: [modelTemplateId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([groupId, modelTemplateId, createdAt])
  @@map("viewer_chat")
}

// ============================================
// VIEWER CHAT READ STATUS
// Tracks the last-read timestamp per user per viewer chat context
// ============================================
model ViewerChatReadStatus {
  id              String   @id @default(cuid())
  userId          String
  groupId         String
  modelTemplateId String
  lastReadAt      DateTime

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, modelTemplateId])
  @@index([userId])
  @@map("viewer_chat_read_status")
}
